<?xml version="1.0" encoding="utf-8"?>
<!--
  窓（キーボード・分割画面・小窓）と、画面の部品（ボタン・画像など）の「位置・大きさ・種類」だけを使う。
  文字の中身・入力内容・説明文・ID は読まない（ScreenScanner.kt だけが部品に触れ、PrivacyGuardTest が確かめる）。
  部品を壁にする設定が入っているときだけ、画面の変化の合図を多めに受け取る（BounceService が切り替える）。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:notificationTimeout="0"
    android:settingsActivity="jp.haruto.phonebounce.MainActivity" />
